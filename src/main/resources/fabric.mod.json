{
  "schemaVersion": 1,
  "id": "cof",
  "version": "@version@",

  "name": "@mod_name@",
  "description": "一批可开关的原版改动：炼药锅结冰、水桶/水瓶不消耗、低价村民等。A Carpet add-on with toggleable vanilla tweaks: cauldron freezing, non-consuming water buckets and bottles, low-price villagers, and more.",
  "license": "MIT",
  "icon": "assets/cof/icon.png",
  "authors": [
    "ColiFish"
  ],
  "contact": {
    "homepage": "https://github.com/ColiFish/Carpet-CoF-Addition",
    "sources": "https://github.com/ColiFish/Carpet-CoF-Addition",
    "issues": "https://github.com/ColiFish/Carpet-CoF-Addition/issues"
  },

  "environment": "*",
  "entrypoints": {
    "main": [
      "carpet.cof.CofMod"
    ]
  },
  "mixins": [
    "cof.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "carpet": ">=1.4.161"
  }
}
