{
  "schemaVersion": 1,
  "id": "cof",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "水炼药锅在可降雪群系露天结冰并掉落产物（冰块/浮冰/蓝冰），另含水桶、水瓶不消耗开关。A Carpet add-on: water cauldrons freeze in snow biomes and drop products.",
  "license": "MIT",
  "authors": [
    "ColiFish"
  ],
  "contact": {
    "homepage": "https://github.com/ColiFish/Carpet-CoF-Addition",
    "sources": "https://github.com/ColiFish/Carpet-CoF-Addition",
    "issues": "https://github.com/ColiFish/Carpet-CoF-Addition/issues"
  },

  "environment": "*",
  "entrypoints": {
    "main": [
      "carpet.cof.CofMod"
    ]
  },
  "mixins": [
    "cof.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "carpet": "*"
  }
}
